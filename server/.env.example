PORT=5050
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/serviceflow?retryWrites=true&w=majority
# Optional. Direct replica-set seed list, used only if the SRV lookup above fails.
MONGODB_URI_FALLBACK=
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
